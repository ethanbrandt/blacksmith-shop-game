    <ui:VisualElement style="flex-grow: 1;">
        <ui:Label text="BLACKSMITH SHOP GAME v0.2" name="Label" style="-unity-text-align: upper-center; padding-left: 0; padding-right: 0; margin-left: 4px; text-shadow: 0 0 0 rgb(255, 255, 255); color: rgb(255, 255, 255); font-size: 24px;"/>
        <ui:Label text="This is a very early build, all art is temp, and nothing is final" style="margin-left: 128px; margin-right: 128px; padding-left: 2px; color: rgb(217, 217, 217); font-size: 12px; -unity-text-align: upper-center; margin-top: 32px;"/>
        <ui:Label text="THIS BUILD ONLY WORKS ON CONTROLLER &amp; ICONS ARE XBOX ONLY" style="padding-left: 4px; margin-top: 32px; color: rgb(219, 110, 110); margin-left: 4px; padding-right: 4px; -unity-text-align: upper-center; -unity-font-style: normal;"/>
        <ui:VisualElement style="flex-grow: 0; flex-direction: row; align-items: center; justify-content: center; align-self: center; margin-top: 48px;">
            <ui:Image source="project://database/Assets/Art/Button%20Icons/D-Pad%20Left.png?fileID=21300000&amp;guid=4df7128435f94964cadc0815a6657c0c&amp;type=3#D-Pad Left" style="width: 20px; height: 20px;"/>
