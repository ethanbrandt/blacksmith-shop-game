            <ui:Image source="project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=-4521532143779581420&amp;guid=5a62e87f30a871e43b630fa8c42b3e67&amp;type=3#arrow-right" style="height: 20px; width: 20px;"/>
