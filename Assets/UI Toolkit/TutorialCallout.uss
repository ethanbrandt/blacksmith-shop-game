.tutorial-card {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    padding: 5px 7px;
    border-width: 1px;
    border-color: rgb(164, 144, 105);
    border-left-width: 3px;
    border-left-color: rgb(132, 97, 64);
    background-color: rgb(245, 238, 209);
    color: rgb(57, 47, 33);
}

.tutorial-card .unity-label {
    margin: 0;
    padding: 0;
}

.tutorial-card .is-hidden {
    display: none;
}

.tutorial-portrait-frame {
    width: 46px;
    flex-shrink: 0;
    margin-right: 7px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(164, 144, 105);
    background-color: rgb(226, 215, 180);
    overflow: hidden;
}

.tutorial-portrait {
    position: absolute;
    width: 100%;
    height: 100%;
    scale: -1 1;
}

.tutorial-copy {
    flex-grow: 1;
    min-width: 0;
}

.tutorial-heading {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 2px;
}

.tutorial-progress {
    font-size: 7px;
    color: rgb(255, 255, 255);
}

.tutorial-title {
    color: rgb(255, 255, 255);
    flex-shrink: 0;
    margin-bottom: 2px;
    font-size: 10px;
    -unity-font-style: bold;
    white-space: normal;
}

.tutorial-text {
    color: rgb(255, 255, 255);
    flex-shrink: 0;
    font-size: 8.5px;
    white-space: normal;
}

.tutorial-overview {
    height: 78px;
    flex-shrink: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.tutorial-overview .tutorial-card {
    padding: 6px 10px;
}

.tutorial-overview .tutorial-portrait-frame {
    width: 52px;
    margin-right: 12px;
}

.tutorial-overview .tutorial-title {
    font-size: 12px;
}

.tutorial-overview .tutorial-text {
    font-size: 10px;
}

.tutorial-overview .tutorial-card .unity-label {
    color: rgb(0, 0, 0);
}

.tutorial-workshop {
    position: absolute;
    top: 4px;
    left: 4px;
    width: 252px;
    max-width: 42%;
    min-height: 76px;
}
