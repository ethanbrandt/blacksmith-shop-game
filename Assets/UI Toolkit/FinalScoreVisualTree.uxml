<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/FinalScoreStyle.uss?fileID=7433441132597879392&amp;guid=7dbccec34970c894d97b89c2a299e7b3&amp;type=3#FinalScoreStyle"/>
    <ui:VisualElement name="FinalScoreScreen" class="final-score-screen">
        <ui:Label text="PIECE FINISHED!" name="Label" class="finish-title"/>
        <ui:VisualElement name="RankDisplay" class="rank-display rank-d">
            <ui:Label text="D" name="RankLetter" class="rank-letter" style="font-size: 128px; margin-top: 96px;"/>
        </ui:VisualElement>
        <ui:VisualElement class="score-layout">
            <ui:VisualElement name="QualityPanel" class="quality-panel score-panel">
                <ui:Label text="OVERALL QUALITY" class="panel-heading"/>
                <ui:VisualElement name="QualityGauge" class="quality-gauge">
                    <ui:VisualElement class="quality-scale">
                        <ui:VisualElement class="quality-frame">
                            <ui:VisualElement name="QualityRail" class="quality-rail">
                                <ui:VisualElement name="DRankBand" class="quality-band rank-d" style="bottom: 0%; height: 12.5%;"/>
                                <ui:VisualElement name="CRankBand" class="quality-band rank-c" style="bottom: 12.5%; height: 25%;"/>
                                <ui:VisualElement name="BRankBand" class="quality-band rank-b" style="bottom: 37.5%; height: 25%;"/>
                                <ui:VisualElement name="ARankBand" class="quality-band rank-a" style="bottom: 62.5%; height: 25%;"/>
                                <ui:VisualElement name="SRankBand" class="quality-band rank-s" style="bottom: 87.5%; height: 12.5%;"/>
                                <ui:VisualElement name="QualityUnrevealed" class="quality-unrevealed"/>
                                <ui:VisualElement name="QualityMarker" class="quality-marker"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="D" name="DRankLabel" class="rank-scale-label" style="bottom: 0%; height: 12.5%;"/>
                        <ui:Label text="C" name="CRankLabel" class="rank-scale-label" style="bottom: 12.5%; height: 25%;"/>
                        <ui:Label text="B" name="BRankLabel" class="rank-scale-label" style="bottom: 37.5%; height: 25%;"/>
                        <ui:Label text="A" name="ARankLabel" class="rank-scale-label" style="bottom: 62.5%; height: 25%;"/>
                        <ui:Label text="S" name="SRankLabel" class="rank-scale-label" style="bottom: 87.5%; height: 12.5%;"/>
                        <ui:Label text="0%" name="DThreshold" class="threshold-label" style="bottom: 0%;"/>
                        <ui:Label text="12.5%" name="CThreshold" class="threshold-label" style="bottom: 12.5%;"/>
                        <ui:Label text="37.5%" name="BThreshold" class="threshold-label" style="bottom: 37.5%;"/>
                        <ui:Label text="62.5%" name="AThreshold" class="threshold-label" style="bottom: 62.5%;"/>
                        <ui:Label text="87.5%" name="SThreshold" class="threshold-label" style="bottom: 87.5%;"/>
                        <ui:Label text="100%" class="threshold-label" style="bottom: 100%;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="0.0%" name="QualityPercent" class="quality-percent"/>
                <ui:Label text="COMBINED RANK SCORE" class="quality-footnote"/>
            </ui:VisualElement>
            <ui:VisualElement name="ToolShowcaseSpace" picking-mode="Ignore" class="tool-showcase-space"/>
            <ui:VisualElement class="result-column">
                <ui:ScrollView name="ScoreBreakdown" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="score-panel score-breakdown is-hidden">
                    <ui:Label text="SCORE BREAKDOWN" class="panel-heading"/>
                    <ui:Label text="Time:" name="TimeTaken" class="score-heading time-heading"/>
                    <ui:Label text="Forging:" name="ForgingScore" class="score-heading"/>
                    <ui:VisualElement name="ForgingPartScores" class="part-score-list"/>
                    <ui:Label text="Grinding:" name="GrindingScore" class="score-heading"/>
                    <ui:VisualElement name="GrindingPartScores" class="part-score-list"/>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
