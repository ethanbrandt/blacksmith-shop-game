:root {
}

.is-hidden {
    display: none;
}

.station-controls {
    flex-grow: 1;
    bottom: auto;
    right: auto;
    top: auto;
    justify-content: flex-end;
    align-self: flex-end;
    flex-direction: row;
    align-items: auto;
    margin-bottom: 4px;
}

.station-control {
    flex-grow: 0;
    flex-direction: row;
    margin-left: 4px;
    margin-right: 4px;
    color: rgb(255, 255, 255);
    font-size: 8px;
}

.station-control .unity-image {
    width: 16px;
    height: 16px;
    margin-right: 2px;
}

.station-control .unity-label {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.heat {
}

.heat .unity-base-slider--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.heat .unity-base-slider--vertical .unity-base-slider__dragger {
    width: 42px;
    height: 4px;
    left: 7px;
    border-width: 0;
    background-color: whitesmoke;
}

.quality-light-on {
}

.s-quality {
    background-color: rgb(108 105 98);
}

.s-quality.quality-light-on {
    background-color: rgb(236 225 31);
}

.a-quality {
    background-color: rgb(108 105 98);
}

.a-quality.quality-light-on {
    background-color: rgb(206 195 54);
}

.b-quality {
    background-color: rgb(108 105 98);
}

.b-quality.quality-light-on {
    background-color: rgb(196 181 77);
}

.c-quality {
    background-color: rgb(108 105 98);
}

.c-quality.quality-light-on {
    background-color: rgb(194 185 82);
}

.d-quality {
    background-color: rgb(108 105 98);
}

.d-quality.quality-light-on {
    background-color: rgb(175 169 107);
}
